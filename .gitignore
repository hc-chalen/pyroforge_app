# ---------------------------------------------------------------------------
# PyroForge — root .gitignore
# Backend- and frontend-specific rules live in backend/.gitignore and
# frontend/.gitignore. This file covers repo-wide concerns.
# ---------------------------------------------------------------------------

# --- Secrets / environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS cruft ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / tooling ---
.idea/
*.swp
*.swo
# Keep shared Cursor plans, ignore local settings
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Large ML data / embeddings (NOT stored in git — too large for GitHub/LFS)
# Archived on Zenodo instead; see DATA.md for the DOIs and column provenance.
#   esm2_train.pt (~2.9 GB), esm2_test.pt (~107 MB)
# ---------------------------------------------------------------------------
*.pt
*.pth
*.npz
*.npy
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.onnx
*.safetensors

# Precomputed ESM2 embeddings at repo root
/esm2_*.pt

# ---------------------------------------------------------------------------
# Zenodo upload staging — rebuilt by backend/scripts/export_public_dataset.py.
# ~3 GB of derived copies; only the checksum manifest is worth tracking.
# ---------------------------------------------------------------------------
/release/*
!/release/MANIFEST.json

.cursor/
# --- Access gate (temporary trial login layer — see docs/OPERATIONS.md) ---
# Real account hashes, never committed.
auth/users.yml

# --- Usage logs written by the auth gateway ---
logs/
