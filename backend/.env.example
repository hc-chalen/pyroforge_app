REDIS_URL=redis://localhost:6379/0
TWIST_API_KEY=
TWIST_API_BASE=https://api.twistbioscience.com
IGEM_API_BASE=https://parts.igem.org/cgi
ESMFOLD_API_URL=https://api.esmatlas.com/foldSequence/v1/pdb/
# Tried only when ESMFOLD_API_URL is down (timeout, unreachable, 5xx/429). Empty = no fallback.
ESMFOLD_FALLBACK_API_URL=
MMSEQS_BIN=mmseqs
# Training data. Only needed to retrain — serving reads the checkpoints alone.
# Must carry `parent_protein_ids` for the leakage-free split (see DATA.md).
DATA_PATH=../esm2_train.pt
TEST_DATA_PATH=../esm2_test.pt
CHECKPOINT_DIR=./checkpoints
DEVICE=cpu
