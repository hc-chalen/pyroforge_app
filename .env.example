# ---------------------------------------------------------------------------
# PyroForge — environment template. Copy to .env on the server (.env is
# gitignored) and fill in. Compose reads .env automatically.
# ---------------------------------------------------------------------------

# --- Core deployment -------------------------------------------------------
# cuda on the school GPU server, cpu elsewhere. Never mps (see backend config).
DEVICE=cuda

# Browser origins allowed to call the API directly. With the same-origin nginx
# proxy the browser never does, so this only matters for cross-origin dev.
# CORS_ORIGINS=["http://100.65.250.65:3002"]
