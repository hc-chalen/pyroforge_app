# ---------------------------------------------------------------------------
# PyroForge — environment template. Copy to .env on the server (.env is
# gitignored) and fill in. Compose reads .env automatically.
# ---------------------------------------------------------------------------

# --- Core deployment -------------------------------------------------------
# cuda on the school GPU server, cpu elsewhere. Never mps (see backend config).
DEVICE=cuda

# --- GPUs (docker-compose.gpu.yml) -----------------------------------------
# Card indices as `nvidia-smi` prints them. ESMFold gets its own card: ~9 GB peak
# at 400 residues, one fold at a time.
# PYROFORGE_GPU=0
# ESMFOLD_GPU=1

# Public ESM Atlas API, used only while the self-hosted esmfold service is down or
# its queue is full. Uncomment with an empty value to keep sequences on this server.
# ESMFOLD_FALLBACK_API_URL=

# Browser origins allowed to call the API directly. With the same-origin nginx
# proxy the browser never does, so this only matters for cross-origin dev.
# CORS_ORIGINS=["http://100.65.250.65:3002"]
