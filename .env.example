# ---------------------------------------------------------------------------
# PyroForge — environment template. Copy to .env on the server (.env is
# gitignored) and fill in. Compose reads .env automatically.
# ---------------------------------------------------------------------------

# --- Core deployment -------------------------------------------------------
# cuda on the school GPU server, cpu elsewhere. Never mps (see backend config).
DEVICE=cuda

# Browser origins allowed to call the API directly. With the same-origin nginx
# proxy the browser never does, so this only matters for cross-origin dev.
# CORS_ORIGINS=["http://100.65.250.65:3002"]


# ---------------------------------------------------------------------------
# Access gate — TEMPORARY. Delete this whole section when the login layer is
# removed after the trial period (docs/OPERATIONS.md).
# ---------------------------------------------------------------------------

# Signs session cookies. Generate ONCE with:  openssl rand -base64 32
# Changing it invalidates every session — which is also how you force-logout
# everyone at the end of the trial.
AUTH_SECRET_KEY=

# How long a session lasts. Actively-used sessions renew themselves past the
# halfway point, so this is the idle timeout in practice.
AUTH_SESSION_DAYS=14

# Set to true ONLY when the deployment is served over HTTPS. On plain http the
# browser would refuse to send the cookie and nobody could log in.
AUTH_COOKIE_SECURE=false
